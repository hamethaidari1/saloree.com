# Copy this file to .env and fill in real values. Never commit .env.

# --- Supabase (Dashboard -> Project Settings -> API) ---
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only. Bypasses row level security — used by the Stripe webhook
# (src/routes/api.stripe-webhook.ts). Never expose to the client or prefix
# with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard -> Developers) ---
# Server-only secret key (API keys page).
STRIPE_SECRET_KEY=
# Publishable key — the only Stripe value safe to expose to the client.
VITE_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe-webhook,
# listening for checkout.session.completed.
STRIPE_WEBHOOK_SECRET=
